generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  auth0Sub  String    @unique
  email     String?
  createdAt DateTime  @default(now())
  summaries Summary[]

  preferredProvider      String?
  preferredMode          String  @default("quick")
  preferredExportFormat  String  @default("txt")
}

model Summary {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputText       String
  outputText      String
  provider        String
  model           String?
  mode            String   @default("quick")
  inputWordCount  Int      @default(0)
  outputWordCount Int      @default(0)
  promptVersion   String?
  qualityScore    Int?
  qualityFlags    String[] @default([])
  createdAt       DateTime @default(now())
  sharedSummary   SharedSummary?
  chatMessages    ChatMessage[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, mode])
  @@index([userId, provider])
}

model SharedSummary {
  id        String    @id @default(uuid())
  token     String    @unique
  summaryId String    @unique
  summary   Summary   @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model ChatMessage {
  id        String   @id @default(uuid())
  summaryId String
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([summaryId, createdAt])
}
